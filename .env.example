# The dedicated Instagram account. Never a personal login.
IG_USERNAME=
IG_PASSWORD=

# Host folder that downloads are written into.
OUT_DIR=./downloads

# Posts fetched per "Load more".
PAGE_SIZE=36

# Seconds enforced between Instagram requests.
IG_MIN_INTERVAL=3

# Seconds the breaker holds after a 429.
IG_BACKOFF=900

# real | fake  -- "fake" runs with no network, used by the e2e suite.
IG_ADAPTER=real

# Force anonymous mode even when credentials are set. Leaving IG_USERNAME and
# IG_PASSWORD empty is already anonymous.
# Measured 2026-08-23: Instagram 429s anonymous profile lookups on the first
# request, so anonymous mode runs but cannot currently retrieve anything.
IG_ANONYMOUS=

# Longest nap this tool will take on Instagram's behalf. Instaloader wants to
# sleep ~30 minutes after a 429; past this it hands control back so the breaker
# can trip visibly instead of freezing the worker.
IG_MAX_SLEEP=60
