# Meta Graph API credentials. See
# docs/superpowers/specs/2026-08-24-instagram-graph-api-design.md for the
# one-time account setup these come from.
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=

# Pinned Graph API version, e.g. v23.0. Required: never defaulted in code, so
# that a Meta deprecation is a config change rather than a release.
IG_GRAPH_VERSION=

# How many pages deep to re-list when a cached media url has expired. Media
# urls exist only inside a listing response, so a post opened long after it
# was indexed needs one of these to find a fresh url.
IG_GRAPH_REFRESH_PAGES=2

# Percentage of Meta's app-usage allowance at which to stop spending calls.
IG_GRAPH_USAGE_LIMIT=90

# Host folder that downloads are written into.
OUT_DIR=./downloads

# Posts indexed on a first look at a profile. Every post here costs a
# thumbnail request, so this stays small until you ask for more.
FIRST_PAGE_SIZE=3

# Posts fetched per "Load more".
PAGE_SIZE=36

# Seconds enforced between Instagram requests.
IG_MIN_INTERVAL=3

# Seconds the breaker holds after a rate limit. A floor only: when Meta
# estimates a longer wait, that wait wins.
IG_BACKOFF=900

# graph | fake  -- "fake" runs with no network and is used by the e2e suite.
IG_ADAPTER=graph
